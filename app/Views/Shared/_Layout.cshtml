@using Microsoft.AspNetCore.Identity
@using MessengerApp.Models
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Месенджер</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/app.styles.css" asp-append-version="true" />
</head>
<body>
@{
    var signedIn = SignInManager.IsSignedIn(User);
    var userName = UserManager.GetUserName(User);
    var initial = string.IsNullOrEmpty(userName) ? "?" : userName.Substring(0, 1).ToUpper();
    var meAvatar = signedIn ? (await UserManager.GetUserAsync(User))?.AvatarData : null;
}
<div class="app">
    <aside class="side">
        <div class="side-brand">
            <a asp-controller="Home" asp-action="Index">💬 Месенджер</a>
        </div>

        <nav class="side-nav">
            <a asp-controller="Home" asp-action="Index">🏠 Головна</a>
            @if (signedIn)
            {
                <a asp-controller="Chart" asp-action="Index">📊 Графік</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Users">👥 Користувачі</a>
                }
            }
        </nav>

        @if (signedIn)
        {
            <div class="side-chatlist">
                @await Component.InvokeAsync("ChatList")
            </div>
        }
        else
        {
            <div class="side-chatlist side-guest">
                <p>Увійдіть, щоб бачити чати та листуватися.</p>
            </div>
        }

        <div class="side-user">
            @if (signedIn)
            {
                <button type="button" class="user-btn" data-popup="userMenu">
                    <div class="avatar sm">@if (!string.IsNullOrEmpty(meAvatar)) { <img src="@meAvatar" alt="" /> } else { @initial }</div>
                    <span class="user-name">@userName</span>
                    <span class="dots">⋮</span>
                </button>
                <div class="popup popup-up" id="userMenu">
                    <a asp-controller="Account" asp-action="Profile">👤 Профіль</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Users">👥 Користувачі</a>
                    }
                    <a asp-controller="Chart" asp-action="Index">📊 Графік</a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit">🚪 Вийти</button>
                    </form>
                </div>
            }
            else
            {
                <a class="btn btn-primary w-100 mb-2" asp-controller="Account" asp-action="Login">Вхід</a>
                <a class="btn btn-outline-secondary w-100" asp-controller="Account" asp-action="Register">Реєстрація</a>
            }
        </div>
    </aside>

    <main class="content">
        @RenderBody()
    </main>
</div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
