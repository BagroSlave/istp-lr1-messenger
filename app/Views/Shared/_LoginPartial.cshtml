@using Microsoft.AspNetCore.Identity
@using MessengerApp.Models
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@* Навігація входу/виходу за іменем користувача (ASP.NET Identity, без email). *@
<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <span class="nav-link">Привіт, @UserManager.GetUserName(User)!</span>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="nav-link btn btn-link">Вийти</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-controller="Account" asp-action="Register">Реєстрація</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-controller="Account" asp-action="Login">Вхід</a>
    </li>
}
</ul>
