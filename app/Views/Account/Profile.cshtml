@model MessengerApp.Models.AppUser
@{
    ViewData["Title"] = "Профіль";
    var initial = string.IsNullOrEmpty(Model.UserName) ? "?" : Model.UserName.Substring(0, 1).ToUpper();
}

<h1>👤 Профіль</h1>

@if (TempData["ProfileResult"] != null)
{
    <div class="alert alert-info">@TempData["ProfileResult"]</div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="avatar">
                        @if (!string.IsNullOrEmpty(Model.AvatarData))
                        {
                            <img src="@Model.AvatarData" alt="Аватар" />
                        }
                        else
                        {
                            @initial
                        }
                    </div>
                    <div>
                        <div style="font-weight:700;font-size:1.1rem">@Model.UserName</div>
                        <div class="text-muted">Поточний аватар</div>
                    </div>
                </div>

                <form asp-action="Profile" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Нове зображення (до 3 МБ)</label>
                        <input type="file" name="avatar" accept="image/*" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary">💾 Зберегти аватар</button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Назад</a>
                </form>
            </div>
        </div>
    </div>
</div>
