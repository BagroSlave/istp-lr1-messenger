@model MessengerApp.Models.Chat
@{
    ViewData["Title"] = "Видалити чат";
}

<h1>Видалити чат</h1>

<div class="alert alert-warning">
    Ви впевнені, що хочете видалити цей чат? Усі його повідомлення також буде видалено.
</div>

<dl class="row">
    <dt class="col-sm-2">Назва</dt>
    <dd class="col-sm-10">@Model.Title</dd>
    <dt class="col-sm-2">Повідомлень</dt>
    <dd class="col-sm-10">@Model.Messages.Count</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Видалити</button>
    <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
</form>
